{
  "properties": {
    "parameters": {
      "SourceWorkSpaceId": {
        "type": "String"
      },
      "SourceLakehouseId": {
        "type": "String"
      },
      "FileName": {
        "type": "String"
      },
      "Compression": {
        "type": "String"
      },
      "TargetWorkSpaceId": {
        "type": "String"
      },
      "TargetLakehouseId": {
        "type": "String"
      },
      "TargetSchema": {
        "type": "String"
      },
      "TargetName": {
        "type": "String"
      },
      "LoadType": {
        "type": "String",
        "defaultValue": "Overwrite"
      }
    },
    "activities": [
      {
        "type": "Copy",
        "name": "cp_landing_to_bronze",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "typeProperties": {
          "source": {
            "type": "ParquetSource",
            "storeSettings": {
              "type": "LakehouseReadSettings",
              "recursive": true,
              "enablePartitionDiscovery": false
            },
            "datasetSettings": {
              "type": "Parquet",
              "typeProperties": {
                "location": {
                  "type": "LakehouseLocation",
                  "fileName": {
                    "value": "@pipeline().parameters.FileName",
                    "type": "Expression"
                  }
                },
                "compressionCodec": {
                  "value": "@pipeline().parameters.Compression",
                  "type": "Expression"
                }
              },
              "connectionSettings": {
                "type": "Lakehouse",
                "typeProperties": {
                  "workspaceId": {
                    "value": "@pipeline().parameters.SourceWorkSpaceId",
                    "type": "Expression"
                  },
                  "artifactId": {
                    "value": "@pipeline().parameters.SourceLakehouseId",
                    "type": "Expression"
                  },
                  "rootFolder": "Files"
                }
              }
            }
          },
          "sink": {
            "type": "LakehouseTableSink",
            "tableActionOption": {
              "value": "@pipeline().parameters.LoadType",
              "type": "Expression"
            },
            "partitionOption": "None",
            "datasetSettings": {
              "type": "LakehouseTable",
              "typeProperties": {
                "schema": {
                  "value": "@pipeline().parameters.TargetSchema",
                  "type": "Expression"
                },
                "table": {
                  "value": "@pipeline().parameters.TargetName",
                  "type": "Expression"
                }
              },
              "connectionSettings": {
                "type": "Lakehouse",
                "typeProperties": {
                  "workspaceId": {
                    "value": "@pipeline().parameters.TargetWorkSpaceId",
                    "type": "Expression"
                  },
                  "artifactId": {
                    "value": "@pipeline().parameters.TargetLakehouseId",
                    "type": "Expression"
                  },
                  "rootFolder": "Tables"
                }
              }
            }
          },
          "enableStaging": false,
          "translator": {
            "type": "TabularTranslator"
          },
          "typeConversionSettings": {
            "typeConversion": {
              "allowDataTruncation": true,
              "treatBooleanAsNumber": false
            }
          },
          "auditColumns": [
            {
              "name": "copy_job_id",
              "value": {
                "value": "@pipeline().Pipeline",
                "type": "Expression"
              }
            },
            {
              "name": "copy_job_run_id",
              "value": {
                "value": "@pipeline().RunId",
                "type": "Expression"
              }
            },
            {
              "name": "copy_job_name",
              "value": {
                "value": "@activity('cp_landing_to_bronze').name",
                "type": "Expression"
              }
            },
            {
              "name": "timestamp",
              "value": {
                "value": "@utcnow()",
                "type": "Expression"
              }
            }
          ]
        }
      }
    ]
  }
}
